full: '0.75rem' }, spacing: { gutter: '0.5rem', 'space-lg': '0.75rem', 'margin-desktop': '0.75rem', 'space-xs': '0.125rem', 'space-sm': '0.25rem', 'gutter-desktop': '0.75rem', 'space-xl': '1rem', margin: '0.5rem', 'space-md': '0.5rem', 'space-2xl': '1.5rem' }, fontFamily: { 'headline-md': ['Geist'], 'body-sm': ['Inter'], 'code-sm': ['JetBrains Mono'], 'body-lg': ['Inter'], 'headline-sm': ['Geist'], 'headline-lg': ['Geist'], 'label-md': ['Inter'], 'label-sm': ['Inter'], 'body-md': ['Inter'] }, fontSize: { 'headline-md': ['1.25rem', { lineHeight: '1.75rem', letterSpacing: '-0.01em', fontWeight: '600' }], 'body-sm': ['0.75rem', { lineHeight: '1.125rem', fontWeight: '400' }], 'code-sm': ['0.75rem', { lineHeight: '1.125rem', fontWeight: '400' }], 'body-lg': ['0.9375rem', { lineHeight: '1.6rem', fontWeight: '400' }], 'headline-sm': ['1rem', { lineHeight: '1.5rem', letterSpacing: '-0.005em', fontWeight: '600' }], 'headline-lg': ['1.5rem', { lineHeight: '2rem', letterSpacing: '-0.02em', fontWeight: '600' }], 'label-md': ['0.8125rem', { lineHeight: '1.25rem', letterSpacing: '0.01em', fontWeight: '500' }], 'label-sm': ['0.6875rem', { lineHeight: '1rem', letterSpacing: '0.02em', fontWeight: '500' }], 'body-md': ['0.8125rem', { lineHeight: '1.375rem', fontWeight: '400' }] } } } };</script></head><body class="bg-surface-container-lowest font-body-md text-on-surface select-none min-h-screen"><header class="fixed top-0 left-0 right-0 z-50 flex flex-col bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="h-8 px-space-md flex items-center justify-between bg-surface-container-lowest"><div class="flex items-center gap-space-md"><span class="material-symbols-outlined text-primary text-[16px]">translate</span><span class="font-headline-sm text-label-sm text-on-surface tracking-tight">Trình dịch tiểu thuyết Trung → Việt — Quản lý tác phẩm và thuật ngữ</span><div class="flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-surface-container-high"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span><span class="font-code-sm text-code-sm text-secondary">Ollama 127.0.0.1:11434</span><span class="text-outline-variant font-code-sm text-code-sm">/</span><span class="font-code-sm text-code-sm text-on-surface-variant">Qwen-2.5-14B</span></div></div><div class="flex items-center gap-space-md"><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div><div class="flex items-center"><button aria-label="Minimize window" class="w-8 h-6 flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface" type="button"><span class="material-symbols-outlined text-[14px]">minimize</span></button><button aria-label="Maximize window" class="w-8 h-6 flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface" type="button"><span class="material-symbols-outlined text-[13px]">check_box_outline_blank</span></button><button aria-label="Close window" class="w-8 h-6 flex items-center justify-center text-on-surface-variant hover:bg-error-container hover:text-on-error-container" type="button"><span class="material-symbols-outlined text-[14px]">close</span></button></div></div></div><div class="h-8 px-space-md bg-surface-container-low flex items-center justify-between text-code-sm font-code-sm text-on-surface-variant"><div class="flex items-center gap-space-lg overflow-hidden whitespace-nowrap"><div class="flex items-center gap-space-xs"><span class="text-primary font-label-sm text-label-sm uppercase tracking-wider">Nguồn:</span><span class="text-on-surface px-space-sm py-0.5 rounded bg-surface-container-high text-code-sm">D:\TruyenA\TieuThuyet_DaiQuanGia.txt</span></div><div class="flex items-center gap-space-xs"><span class="text-secondary font-label-sm text-label-sm uppercase tracking-wider">Đích:</span><span class="text-on-surface px-space-sm py-0.5 rounded bg-surface-container-high text-code-sm">D:\TruyenA\</span></div></div><div class="flex items-center gap-space-sm"><button class="flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-surface-container hover:bg-surface-container-high text-on-surface hover:text-on-surface transition-colors font-label-sm text-label-sm" type="button"><span class="material-symbols-outlined text-[14px] text-primary">folder_open</span>Mở thư mục đích</button><button class="flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-surface-container hover:bg-surface-container-high text-on-surface hover:text-on-surface transition-colors font-label-sm text-label-sm" type="button"><span class="material-symbols-outlined text-[14px] text-primary">sync</span>Đồng bộ cấu hình</button></div></div></header><aside class="fixed left-0 top-16 bottom-7 w-64 bg-surface-container-low z-40 flex flex-col justify-between py-space-sm"><div class="flex flex-col gap-space-xs px-space-sm"><div class="px-space-md py-space-xs text-outline font-label-sm text-label-sm uppercase tracking-wider">Các phân hệ xử lý</div><nav class="flex flex-col gap-space-xs" data-active-classes="bg-primary-container text-on-primary-container font-headline-sm"><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="tong-quan-&amp;-cau-hinh" href="#"><span class="material-symbols-outlined text-[18px]">tune</span><span>A. Tổng quan &amp; Cấu hình</span></a><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="bao-cao-tac-pham" href="#"><span class="material-symbols-outlined text-[18px]">analytics</span><span>B. Báo cáo tác phẩm</span></a><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="nhan-vat-moc" href="#"><span class="material-symbols-outlined text-[18px]">group</span><span>C. Nhân vật mốc</span></a><a aria-current="page" class="flex items-center gap-space-md px-space-md py-space-sm rounded transition-colors bg-primary-container text-on-primary-container font-headline-sm" data-path="goi-y-moegirl" href="#"><span class="material-symbols-outlined text-[18px]">lightbulb</span><span>D. Gợi ý Moegirl</span></a><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="quan-ly-glossary" href="#"><span class="material-symbols-outlined text-[18px]">menu_book</span><span>E. Quản lý Glossary</span></a><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="dich-&amp;-tien-trinh" href="#"><span class="material-symbols-outlined text-[18px]">bolt</span><span>F. Dịch &amp; Tiến trình</span></a><a class="flex items-center gap-space-md px-space-md py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-label-md text-label-md" data-path="nhat-ky-&amp;-kiem-tra" href="#"><span class="material-symbols-outlined text-[18px]">terminal</span><span>G. Nhật ký &amp; Kiểm tra</span></a></nav></div><div class="px-space-md py-space-sm mx-space-sm rounded bg-surface-container flex flex-col gap-space-xs"><div class="flex items-center justify-between text-label-sm font-label-sm text-outline"><span class="flex items-center gap-space-xs"><span class="material-symbols-outlined text-[14px]">database</span>Bộ nhớ TM/Glossary</span><span class="text-primary font-code-sm text-code-sm">42,819 mục</span></div><div class="flex items-center justify-between text-label-sm font-label-sm text-outline"><span class="flex items-center gap-space-xs"><span class="material-symbols-outlined text-[14px]">batch_prediction</span>Hàng đợi dịch</span><span class="text-secondary font-code-sm text-code-sm">24 chương</span></div></div></aside><div class="pl-64"><main class="relative pt-16 pb-7 w-full px-space-md min-h-screen bg-surface"><div class="flex flex-col w-full gap-space-md text-on-surface">
<!-- Sub-header Breadcrumb & Operational Alert Tier -->
<div class="flex flex-col gap-space-sm bg-surface-container-low p-space-md rounded shadow-sm">
<div class="flex items-center justify-between flex-wrap gap-space-md">
<div class="flex items-center gap-space-md">
<div class="w-8 h-8 rounded bg-primary-container/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[20px]">lightbulb</span>
</div>
<div>
<div class="flex items-center gap-space-xs font-code-sm text-code-sm text-outline">
<span>D:</span>
<span>/</span>
<span class="text-on-surface-variant font-label-md text-label-md">Gợi ý Moegirl</span>
<span>/</span>
<span class="text-primary font-code-sm text-code-sm">moegirl_suggestions.txt</span>
<span class="px-space-xs py-0.2 rounded bg-surface-container-highest text-label-sm text-label-sm text-outline-variant font-mono">BÁO CÁO ỨNG VIÊN</span>
</div>
<h1 class="font-headline-sm text-headline-sm text-on-surface tracking-tight">Trích Xuất &amp; Kiểm Duyệt Thuật Ngữ Ngoại Vi</h1>
</div>
</div>
<!-- Action Button Group -->
<div class="flex items-center gap-space-sm flex-wrap">
<button class="h-7 px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md font-label-md flex items-center gap-space-xs transition-colors shadow-sm" type="button">
<span class="material-symbols-outlined text-[16px] text-primary">restart_alt</span>
<span>Tạo lại gợi ý từ truyện</span>
</button>
<button class="h-7 px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md font-label-md flex items-center gap-space-xs transition-colors shadow-sm" type="button">
<span class="material-symbols-outlined text-[16px] text-outline">file_download</span>
<span>Xuất gợi ý (TXT/TSV)</span>
</button>
<button class="h-7 px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface text-label-md font-label-md flex items-center gap-space-xs transition-colors" type="button">
<span class="material-symbols-outlined text-[16px]">filter_alt_off</span>
<span>Xóa bộ lọc</span>
</button>
<!-- Cache Build Actions -->
<button class="h-7 px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md font-label-md flex items-center gap-space-xs transition-colors shadow-sm" id="btn-build-project-cache" type="button"><span class="material-symbols-outlined text-[16px] text-secondary">storage</span><span>Dựng cache dự án</span></button>
<button class="h-7 px-space-md rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md font-label-md flex items-center gap-space-xs transition-colors shadow-sm" id="btn-rebuild-cache" type="button"><span class="material-symbols-outlined text-[16px] text-outline">database</span><span>Dựng lại kho Moegirl</span></button>
<!-- Primary Commit Trigger (Protected) -->
<button class="h-7 px-space-md rounded bg-primary-container hover:bg-primary-container/90 text-on-primary-container text-label-md font-label-md flex items-center gap-space-xs font-semibold shadow-sm transition-all group" id="open-commit-modal-btn" type="button">
<span class="material-symbols-outlined text-[16px] text-on-primary-container">system_update_alt</span>
<span>Thêm mục đã duyệt vào thuatngu.txt</span>
<span class="px-1.5 py-0.2 rounded-full bg-surface-container-lowest text-secondary font-code-sm text-code-sm group-hover:scale-105 transition-transform">3 mục</span>
</button>
</div>
</div>
<!-- Strict Guard Banner -->
<div class="flex items-start gap-space-md p-space-md rounded bg-surface-container-highest/60 text-on-surface relative overflow-hidden">
<div class="absolute left-0 top-0 bottom-0 w-1 bg-tertiary"></div>
<span class="material-symbols-outlined text-tertiary text-[20px] mt-0.5">verified_user</span>
<div class="flex flex-col gap-0.5 flex-1 min-w-0">
<div class="flex items-center gap-space-sm">
<span class="text-tertiary font-label-md text-label-md font-semibold uppercase tracking-wider">Cảnh báo quy tắc kiểm duyệt</span>
<span class="text-label-sm font-label-sm px-space-xs py-0.5 rounded bg-surface-container-high text-outline">Quy chuẩn v3.4</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
<strong class="text-on-surface">Nghiêm cấm tự động commit vào glossary:</strong> Chỉ mục được người dùng bấm duyệt và xác nhận mới được thêm vào <code class="text-primary font-code-sm text-code-sm">thuatngu.txt</code>. Các thuật ngữ chưa kiểm chứng hoặc độ tin cậy thấp bắt buộc duy trì trạng thái <span class="text-tertiary-fixed font-semibold">Chờ duyệt</span> nhằm tránh ô nhiễm bộ nhớ dịch bản vị.
        </p>
</div>
<div class="flex items-center gap-space-xs font-code-sm text-code-sm text-outline self-center px-space-sm py-1 rounded bg-surface-container-low">
<span class="material-symbols-outlined text-[14px] text-secondary">lock</span>
<span>WRITE-PROTECTED</span>
</div>
</div>
</div>
<!-- Filter & Metadata Ribbon -->
<div class="flex items-center justify-between gap-space-md flex-wrap bg-surface-container p-space-sm rounded">
<div class="flex items-center gap-space-md flex-wrap flex-1 min-w-[320px]">
<!-- Novel Selector -->
<div class="flex items-center gap-space-xs text-label-sm font-label-sm">
<span class="text-outline uppercase tracking-wider">Tác phẩm:</span>
<div id="work-filter" class="flex items-center gap-space-xs">
<button class="px-space-sm py-1 rounded bg-primary-container text-on-primary-container font-label-md text-label-md flex items-center gap-1 shadow-sm" type="button">
<span>Đấu Phá Thương Khung</span>
<span class="px-1 rounded bg-surface-container-lowest text-primary font-code-sm text-code-sm">18</span>
</button>
<button class="px-space-sm py-1 rounded bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant font-label-md text-label-md flex items-center gap-1 transition-colors" type="button">
<span>Toàn Chức Cao Thủ</span>
<span class="px-1 rounded bg-surface-container-lowest text-outline font-code-sm text-code-sm">12</span>
</button>
<button class="px-space-sm py-1 rounded bg-surface-container-high hover:bg-surface-container-highest text-outline font-label-md text-label-md flex items-center gap-1" type="button">
<span>Tất cả đã duyệt</span>
<span class="px-1 rounded bg-surface-container-lowest text-outline font-code-sm text-code-sm">30</span>
</button>
</div>
</div>
<!-- Verification Status Selector -->
<div class="flex items-center gap-space-xs text-label-sm font-label-sm">
<span class="text-outline uppercase tracking-wider">Trạng thái:</span>
<select id="status-filter" class="h-7 px-space-sm bg-surface-container-low text-on-surface rounded text-label-sm font-label-sm focus:outline-none focus:ring-1 focus:ring-primary">
<option value="all">Toàn bộ danh sách</option>
<option selected="" value="pending">Chờ duyệt (Pending)</option>
<option value="approved">Đã duyệt (Verified)</option>
<option value="rejected">Từ chối (Discarded)</option>
</select>
</div>
<!-- High-speed Filter Bar -->
<div class="flex items-center bg-surface-container-low rounded px-space-sm h-7 flex-1 min-w-[200px] max-w-sm">
<span class="material-symbols-outlined text-[16px] text-outline mr-space-xs">search</span>
<input id="search-input" class="bg-transparent w-full text-body-sm font-body-sm text-on-surface placeholder:text-outline focus:outline-none" placeholder="Tìm tên Trung, Latin, Pinyin, ghi chú..." type="text" value=""/>
<div class="flex items-center gap-0.5 text-outline-variant font-code-sm text-code-sm">
<span class="px-1 rounded bg-surface-container hover:text-primary cursor-pointer text-[10px]">Aa</span>
<span class="px-1 rounded bg-surface-container hover:text-primary cursor-pointer text-[10px]">.*</span>
</div>
</div>
</div>
<!-- Quick Stats Metric Pills -->
<div class="flex items-center gap-space-sm text-code-sm font-code-sm text-outline">
<div class="flex items-center gap-1 bg-surface-container-low px-space-sm py-0.5 rounded">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
<span>Hợp lệ: <strong class="text-on-surface">30/30</strong></span>
</div>
<div class="flex items-center gap-1 bg-surface-container-low px-space-sm py-0.5 rounded">
<span class="material-symbols-outlined text-[14px] text-tertiary">warning</span>
<span>Đã lọc rác: <strong class="text-on-surface">144</strong></span>
</div>
</div>
</div>
<!-- Primary Translation Workstation: Split Table & Inspection Panel -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-space-md w-full items-start">
<!-- Suggestions Table Area (8 or 12 Cols depending on inspect toggle) -->
<div class="xl:col-span-8 flex flex-col rounded bg-surface-container-low overflow-hidden shadow-sm">
<div class="h-8 bg-surface-container px-space-md flex items-center justify-between text-label-sm font-label-sm text-outline">
<div class="flex items-center gap-space-md">
<div class="flex items-center gap-space-xs">
<input class="rounded bg-surface-container-highest checked:bg-primary accent-primary" id="check-all" type="checkbox"/>
<label class="cursor-pointer text-on-surface-variant font-semibold" for="check-all">CHỌN TẤT CẢ (6 HIỂN THỊ)</label>
</div>
<span>•</span>
<span>Khớp ngữ cảnh truyện: <strong class="text-secondary">100%</strong></span>
</div>
<div class="flex items-center gap-space-sm font-code-sm text-code-sm">
<span>Sort: Tần suất (Giảm dần)</span>
<span class="material-symbols-outlined text-[14px] text-primary">arrow_downward</span>
</div>
</div>
<div class="w-full overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-lowest text-outline uppercase font-label-sm text-label-sm tracking-wider h-7">
<th class="px-space-md py-1 w-8">#</th>
<th class="px-space-md py-1">Tên nguồn (Trung)</th>
<th class="px-space-md py-1">Tên đích đề xuất (Latin / Hán-Việt)</th>
<th class="px-space-md py-1">Tác phẩm</th>
<th class="px-space-md py-1">Bí danh</th>
<th class="px-space-md py-1 text-right">Tần suất</th>
<th class="px-space-md py-1">Nguồn</th>
<th class="px-space-md py-1">Trạng thái</th>
<th class="px-space-md py-1">Ghi chú &amp; Xung đột</th>
<th class="px-space-md py-1 text-center">Thao tác</th>
</tr>
</thead>
<tbody class="divide-y divide-surface-container font-body-sm text-body-sm text-on-surface-variant">
<!-- Row 1: Xiao Yan -->
<tr class="hover:bg-surface-container transition-colors group">
<td class="px-space-md py-space-sm text-center">
<input checked="" class="rounded bg-surface-container-highest accent-primary" type="checkbox"/>
</td>
<td class="px-space-md py-space-sm font-headline-sm text-label-md text-on-surface font-semibold font-mono">
                萧炎
              </td>
<td class="px-space-md py-space-sm">
<div class="flex items-center gap-space-xs font-label-md text-label-md text-primary font-medium">
<span>Xiao Yan</span>
<span class="text-outline-variant font-normal">(Tiêu Viêm)</span>
</div>
</td>
<td class="px-space-md py-space-sm text-on-surface-variant font-label-sm text-label-sm">
