<script>
  // Simple Micro-interaction script for modal confirmation toggles
  (function() {
    const openBtn = document.getElementById('open-commit-modal-btn');
    const singleConfirmBtn = document.getElementById('trigger-single-confirm');
    const modal = document.getElementById('confirmation-dialog');
    const cancelBtn = document.getElementById('cancel-modal-btn');
    const confirmBtn = document.getElementById('confirm-commit-btn');

    function showModal() {
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function hideModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    if (openBtn) openBtn.addEventListener('click', showModal);
    if (singleConfirmBtn) singleConfirmBtn.addEventListener('click', showModal);
    if (cancelBtn) cancelBtn.addEventListener('click', hideModal);
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        alert('Đã thêm thành công 3 mục vào thuatngu.txt!');
        hideModal();
      });
    }
  })();
</script></main></div><footer class="fixed bottom-0 left-0 right-0 h-7 z-50 bg-surface-container-lowest flex items-center justify-between px-space-md text-label-sm font-label-sm text-outline"><div class="flex items-center gap-space-lg"><div class="flex items-center gap-space-xs"><span class="material-symbols-outlined text-secondary text-[14px]">memory</span><span class="font-code-sm text-code-sm text-on-surface-variant">CPU: 18.4%</span></div><div class="flex items-center gap-space-xs"><span class="material-symbols-outlined text-primary text-[14px]">storage</span><span class="font-code-sm text-code-sm text-on-surface-variant">RAM: 6.2 / 32 GB</span></div><div class="flex items-center gap-space-xs"><span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span><span class="font-label-sm text-label-sm text-on-surface">Workers: 4/4 Luồng Đang Chạy</span></div><div class="flex items-center gap-space-xs text-on-surface-variant"><span class="material-symbols-outlined text-[14px]">speed</span><span class="font-code-sm text-code-sm">Tốc độ: 84 token/s</span></div></div><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-[14px]">check_circle</span><span class="font-code-sm text-code-sm">Auto-Save: Bật</span></div><button class="hover:text-primary transition-colors flex items-center gap-space-xs font-code-sm text-code-sm" type="button"><span class="material-symbols-outlined text-[14px]">folder</span>D:\TruyenA\</button></div></footer></body></html>